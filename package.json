{
  "name": "ikea-planner-assets",
  "version": "1.0.0",
  "private": true,
  "description": "Capture and convert IKEA METHOD, PLATSA, and PAX planner designs into portable 3D assets.",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "capture": "node packages/cli/bin/ikea-assets.js capture-browser",
    "inspect": "node packages/cli/bin/ikea-assets.js inspect",
    "test": "node packages/cli/bin/ikea-assets.js self-test",
    "test:all": "bun run test && bun run web:test",
    "web:dev": "bun --cwd apps/web dev",
    "web:build": "bun --cwd apps/web build",
    "web:test": "bun --cwd apps/web test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
}
