# Optional. Defaults to the repository's bin/ikea-assets.js.
IKEA_PLANNER_CLI_PATH=

# Optional. Job working files are isolated below this directory.
IKEA_PLANNER_EXPORT_WORK_DIR=/tmp/ikea-planner-exports

# Comma-separated extra hostnames accepted for planner share URLs.
# All ikea.com hosts are accepted by default.
IKEA_PLANNER_ALLOWED_HOSTS=

# Remove job working files this many hours after creation.
IKEA_PLANNER_JOB_TTL_HOURS=24

# Throttle expired-job cleanup while the server stays running.
IKEA_PLANNER_CLEANUP_INTERVAL_MINUTES=60

# Run one browser-heavy export at a time unless the machine has spare capacity.
IKEA_PLANNER_MAX_CONCURRENT_JOBS=1

# Reject new work when this many exports are already waiting.
IKEA_PLANNER_MAX_QUEUED_JOBS=8

# Stop a stalled CLI export after this many milliseconds (default: 10 minutes).
IKEA_PLANNER_COMMAND_TIMEOUT_MS=600000
